<?xml version="1.0" encoding="utf-8"?>
<!-- The big numerals at weight 500. The launcher ticks TextClock itself: we never re-render per minute.
     Format, size and colour are set per widget from code. -->
<TextClock xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="google-sans-flex"
    android:textFontWeight="500"
    android:fontFeatureSettings="tnum"
    android:includeFontPadding="false"
    android:letterSpacing="-0.02"
    android:maxLines="1"
    android:singleLine="true" />
