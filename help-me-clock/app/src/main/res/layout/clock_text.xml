<?xml version="1.0" encoding="utf-8"?>
<!-- Small live text (date, AM/PM). TextClock re-formats itself, so the date turns over at midnight
     without waking the app. -->
<TextClock xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="google-sans-flex"
    android:textFontWeight="400"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true" />
