<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for launchers without generated previews (API < 35). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="Mountain View"
            android:textColor="@color/nim_auto_on_surface"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="21°"
            android:textColor="@color/nim_auto_on_surface"
            android:textSize="44sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Partly cloudy · H:23° L:14°"
            android:textColor="@color/nim_auto_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:importantForAccessibility="no"
        android:src="@drawable/wx_partly_cloudy" />
</LinearLayout>
